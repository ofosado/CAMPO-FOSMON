rules_version = '2';

// ─────────────────────────────────────────────────────────────────────────────
// CAMPO — Reglas de seguridad de Firestore
// feature/organizaciones (2026-09):
//  · Añade colección /orgs/{orgId} con tipo ('constructora'|'dependencia'),
//    inmutable después de create.
//  · Propaga orgId + tipo al claim.
//  · Todas las colecciones de constructora exigen tipo=='constructora'.
//  · Declara paths de dependencia denegados a constructora (y viceversa)
//    aunque los datos aún no existan.
//  · Añade rol 'soporte' cross-tipo: puede crear /orgs y /usuarios, NO puede
//    leer avances, montos, evidencia ni comparativos.
//
// Claims esperados en request.auth.token (asignados por sincronizarClaims):
//   rol      : uno de los roles válidos (constructora, dependencia o cross)
//   orgId    : string — id de la organización (null para 'soporte')
//   tipo     : 'constructora' | 'dependencia' | null (null para 'soporte')
//   todas    : bool — true = ve todas las obras de SU org
//   obras    : array<string> con IDs de obras asignadas (si !todas)
//   inactivo : bool — true bloquea todo (usuario desactivado)
// ─────────────────────────────────────────────────────────────────────────────

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── HELPERS ────────────────────────────────────────────────────────────
    function tokenGet(k, def) { return request.auth.token.get(k, def); }
    function esAuth() {
      return request.auth != null
          && tokenGet('inactivo', false) != true
          && tokenGet('rol', null) != null;
    }
    function rol() { return tokenGet('rol', ''); }
    function orgId() { return tokenGet('orgId', ''); }
    function tipoOrg() { return tokenGet('tipo', ''); }
    function todasObras() { return tokenGet('todas', false) == true; }
    function obrasAsignadas() { return tokenGet('obras', []); }

    function esConstructora() { return esAuth() && tipoOrg() == 'constructora'; }
    function esDependencia() { return esAuth() && tipoOrg() == 'dependencia'; }
    function esSoporte() { return esAuth() && rol() == 'soporte'; }

    // ── Directivos constructora (ven toda su org constructora) ──
    function esDirectivoC() {
      return esConstructora() && rol() in ['director_general','director_operaciones','gerente_construccion','admin_sistema'];
    }
    // Admin de gestión (crea usuarios) por org constructora
    function esAdminSistemaC() {
      return esConstructora() && rol() in ['director_general','director_operaciones','admin_sistema'];
    }
    function esEquipoObraEditor() {
      return esConstructora() && rol() in ['superintendente','residente','administrador_obra'];
    }
    function esAuditorC() {
      return esConstructora() && rol() == 'auditor';
    }
    function esCliente() {
      return esConstructora() && rol() == 'cliente';
    }

    // ── Directivos dependencia ──
    // esDirectivoD: lectura amplia (incluye contralor — fiscalización sin edición)
    function esDirectivoD() {
      return esDependencia() && rol() in ['director_obras','subdirector','jefe_supervision','contralor'];
    }
    // esDirectivoDEditor: escritura amplia (excluye contralor). Contralor
    // tiene acceso de solo lectura por diseño (decisión 2026-09).
    function esDirectivoDEditor() {
      return esDependencia() && rol() in ['director_obras','subdirector','jefe_supervision'];
    }
    function esAdminSistemaD() {
      return esDependencia() && rol() in ['director_obras','subdirector'];
    }
    function esSupervisorObra() {
      return esDependencia() && rol() == 'supervisor_obra';
    }
    function esContratista() {
      return esDependencia() && rol() == 'contratista';
    }

    // Unión: cualquier admin de sistema (por org) o soporte cross-tipo.
    function esAdminSistemaOSoporte() {
      return esAdminSistemaC() || esAdminSistemaD() || esSoporte();
    }

    // Puede VER una obra de CONSTRUCTORA: directivo (todas) o rol operativo
    // asignado a esa obra. Cliente ve solo las suyas.
    function puedeVerObraC(id) {
      return esDirectivoC()
          || (esConstructora()
              && rol() in ['superintendente','residente','administrador_obra','auditor','cliente']
              && (todasObras() || id in obrasAsignadas()));
    }
    function puedeEditarObraC(id) {
      return esDirectivoC()
          || (esEquipoObraEditor()
              && (todasObras() || id in obrasAsignadas()));
    }

    // Puede VER una obra de DEPENDENCIA: directivo (todas) o rol operativo
    // asignado. Contratista solo las suyas.
    function puedeVerObraD(id) {
      return esDirectivoD()
          || (esDependencia()
              && rol() in ['supervisor_obra','administrativo','contratista']
              && (todasObras() || id in obrasAsignadas()));
    }
    function puedeEditarObraD(id) {
      return esDirectivoDEditor()
          || ((esSupervisorObra() || rol() == 'administrativo')
              && (todasObras() || id in obrasAsignadas()));
    }

    // Email normalizado a docId
    // BUG 2026-09-15: en Firebase Rules `.replace(re, sub)` interpreta el
    // patrón como REGEX (RE2). El punto `.` es metacaracter, escapar con `\\.`.
    function emailAId(email) {
      return email.lower().replace('@', '_').replace('\\.', '_');
    }
    function esOwnUserDoc(docId) {
      return request.auth != null
          && request.auth.token.email != null
          && docId == emailAId(request.auth.token.email);
    }

    // ─────────────────────────────────────────────────────────────────────
    // orgs/{orgId} — organización (constructora o dependencia)
    // · tipo INMUTABLE después de create
    // · Crea/edita: admin de sistema de la propia org o soporte cross-tipo
    // ─────────────────────────────────────────────────────────────────────
    match /orgs/{oid} {
      // Lectura: cualquier miembro de la org, o soporte
      allow read: if (esAuth() && orgId() == oid) || esSoporte();
      // Crear: soporte (bootstrap) o admin de sistema (para casos edge)
      allow create: if (esSoporte() || esAdminSistemaC() || esAdminSistemaD())
                    && request.resource.data.tipo in ['constructora','dependencia']
                    && request.resource.data.nombre is string
                    && request.resource.data.activa is bool;
      // Update: soporte o admin de la propia org. `tipo` NO se puede cambiar.
      allow update: if (esSoporte() || (esAdminSistemaOSoporte() && orgId() == oid))
                    && request.resource.data.tipo == resource.data.tipo;
      allow delete: if false;  // orgs no se borran, se marcan activa=false
    }

    // ─────────────────────────────────────────────────────────────────────
    // usuarios/{docId} — perfil de cada usuario
    //   · Cada quien lee/crea SU propio doc (auto-alta al login).
    //   · Update lo hace admin de gestión (de la org del usuario) o soporte.
    // ─────────────────────────────────────────────────────────────────────
    match /usuarios/{docId} {
      allow read: if esOwnUserDoc(docId) || esAdminSistemaOSoporte();
      allow create: if esOwnUserDoc(docId) || esAdminSistemaOSoporte();
      allow update: if esAdminSistemaOSoporte();
      allow delete: if esAdminSistemaOSoporte();
    }

    // ═════════════════════════════════════════════════════════════════════
    // CONSTRUCTORA — obras/{obraId} (path legacy, no migrado aún)
    // Todas las lecturas/escrituras exigen tipo=='constructora'.
    // Soporte NUNCA puede leer estos paths (deny explícito por diseño).
    // ═════════════════════════════════════════════════════════════════════
    match /obras/{obraId} {
      allow read: if puedeVerObraC(obraId);
      allow create, update, delete: if esDirectivoC();

      match /config/info {
        allow read: if puedeVerObraC(obraId);
        allow write: if puedeEditarObraC(obraId);
      }
      match /config/parametros {
        allow read: if puedeVerObraC(obraId);
        allow write: if puedeEditarObraC(obraId);
      }
      match /config/estimaciones {
        allow read: if puedeVerObraC(obraId);
        allow write: if puedeEditarObraC(obraId);
      }
      match /config/catalogo {
        allow read: if puedeVerObraC(obraId);
        allow write: if puedeEditarObraC(obraId);
      }
      match /config/otros_gastos {
        allow read: if puedeVerObraC(obraId) && !esCliente();
        allow write: if puedeEditarObraC(obraId);
      }
      match /config/permisos {
        allow read: if puedeVerObraC(obraId);
        allow write: if esDirectivoC();
      }

      match /avance/subs {
        allow read: if puedeVerObraC(obraId);
        allow write: if puedeEditarObraC(obraId);
      }
      match /avance/maquinaria {
        allow read: if puedeVerObraC(obraId) && !esCliente();
        allow write: if puedeEditarObraC(obraId);
      }
      match /avance/materiales {
        allow read: if puedeVerObraC(obraId) && !esCliente();
        allow write: if puedeEditarObraC(obraId);
      }
      match /avance/historial {
        allow read: if puedeVerObraC(obraId) && !esCliente();
        allow write: if puedeEditarObraC(obraId);
      }
      // La nota de cada semana cerrada. Mismo permiso que el historial del que
      // habla; vive aparte sólo porque `avance/historial` se recorta a 52
      // semanas, y una constancia que se borra sola no es constancia.
      match /avance/notas {
        allow read: if puedeVerObraC(obraId) && !esCliente();
        allow write: if puedeEditarObraC(obraId);
      }

      match /nomina/historial {
        allow read: if puedeVerObraC(obraId) && !esCliente();
        allow write: if puedeEditarObraC(obraId);
      }

      // Una semana de nómina por documento (`Y2026-S38`). Es el destino de la
      // migración del #28; convive con `nomina/historial` mientras la bandera
      // `formatoHistorial.nomina` de `config/info` siga diciendo 1.
      //
      // Esta regla va ANTES de escribir la primera vez, no después. Sin ella
      // la ruta cae en el `match /{document=**}` final, que deniega todo, y
      // como las escrituras pasan por helpers que se tragan el fallo, la
      // migración parecería funcionar mientras no guarda nada. Es exactamente
      // lo que le pasó al histórico de subcontratos durante tres años
      // (PENDIENTES #31). Mismos permisos que el documento que reemplaza.
      match /nomina_historial/{semanaId} {
        allow read: if puedeVerObraC(obraId) && !esCliente();
        allow write: if puedeEditarObraC(obraId);
      }

      match /contrato/plazos {
        allow read: if puedeVerObraC(obraId);
        allow write: if puedeEditarObraC(obraId);
      }
      match /contrato/documentos {
        allow read: if puedeVerObraC(obraId) && !esCliente();
        allow write: if puedeEditarObraC(obraId);
      }

      match /subcontratos/lista {
        allow read: if puedeVerObraC(obraId) && !esCliente();
        allow write: if puedeEditarObraC(obraId);
      }

      match /bitacora/{id} {
        allow read: if puedeVerObraC(obraId) && !esCliente();
        allow create: if puedeEditarObraC(obraId);
        allow update, delete: if esDirectivoC();
      }
    }

    // ═════════════════════════════════════════════════════════════════════
    // DEPENDENCIA — /orgs/{orgId}/obras/{obraId}
    // Constructora / cliente / soporte NO pueden leer estos paths.
    //
    // PRINCIPIO (decisión de producto, 2026-09-23) — LA FRONTERA DEL MARGEN
    // ---------------------------------------------------------------------
    // Una dependencia NO ve el costo del contratista. No ve su nómina, ni
    // sus subcontratos, ni su maquinaria, ni su almacén, ni sus otros
    // gastos. Ve avance físico, avance financiero contra contrato, y las
    // incidencias. Nada más.
    //
    // Esto no es una omisión que alguien completará después: es el trato.
    // Un contratista entrega avance a la dependencia que lo contrató; lo
    // que le cuesta ejecutarlo es suyo. Por eso las seis rutas de costo del
    // bloque de constructora —`nomina/historial`, `nomina_historial`,
    // `subcontratos/lista`, `avance/maquinaria`, `avance/materiales` y
    // `config/otros_gastos`— NO tienen equivalente aquí abajo, y no deben
    // tenerlo. Si algún día alguien "completa la simetría", habrá roto el
    // producto sin darse cuenta.
    //
    // Corolario: el PDF ejecutivo de constructora no se le entrega a una
    // dependencia. Enseña «Margen bruto», gasto por rubro y top de
    // proveedores. El informe de dependencia es otro documento.
    //
    // CORRECCIÓN DE MODELO (2026-09-23) — EL SUPERVISOR SÍ CAPTURA
    // ---------------------------------------------------------------------
    // El modelo anterior decía «la constructora ejecuta y captura, la
    // dependencia supervisa», y de ahí salieron las cinco subcolecciones
    // documentales de abajo, ninguna de captura. Es falso: el supervisor de
    // obra va, verifica físicamente y levanta el avance — diario o semanal
    // según lo pida la dirección de Obras Públicas.
    //
    // Sin las rutas de avance, la captura cae en el `match /{document=**}`
    // final y `fsSet` se traga el fallo: parecería funcionar sin guardar
    // nada. Es el defecto del #31 (tres años sin detectarse) y el que se
    // evitó a tiempo en el #28. Ver PENDIENTES #35.
    // ═════════════════════════════════════════════════════════════════════
    match /orgs/{oid}/obras/{obraId} {
      allow read: if oid == orgId() && puedeVerObraD(obraId);
      allow create, update, delete: if oid == orgId() && esDirectivoD();

      // Contratista solo ve el contratista de su propia obra
      match /contratistas/{cid} {
        allow read: if oid == orgId() && (
          esDirectivoD()
          || (esSupervisorObra() && obraId in obrasAsignadas())
          || (esContratista() && obraId in obrasAsignadas() && cid == request.auth.uid)
        );
        allow write: if oid == orgId() && esDirectivoD();
      }
      match /supervisores/{sid} {
        allow read: if oid == orgId() && esDirectivoD();
        allow write: if oid == orgId() && esDirectivoD();
      }
      match /programa/{pid} {
        allow read: if oid == orgId() && puedeVerObraD(obraId);
        allow write: if oid == orgId() && puedeEditarObraD(obraId);
      }
      match /convenios/{cid} {
        allow read: if oid == orgId() && puedeVerObraD(obraId) && !esContratista();
        allow write: if oid == orgId() && (rol() == 'administrativo' || esDirectivoD());
      }
      match /evidencia/{eid} {
        // Supervisor de obra captura evidencia
        allow read: if oid == orgId() && puedeVerObraD(obraId);
        allow create: if oid == orgId() && (esSupervisorObra() || esDirectivoD() || rol() == 'administrativo')
                      && obraId in obrasAsignadas();
        allow update, delete: if oid == orgId() && esDirectivoD();
      }

      // ── CAPTURA DE AVANCE ───────────────────────────────────────────────
      // Espejo de las rutas de constructora, con permisos de dependencia.
      // Escribe quien captura: supervisor_obra y administrativo en sus obras
      // asignadas, y jefe_supervision / director_obras / subdirector en
      // cualquiera (`puedeEditarObraD`). Contralor NO escribe: está en
      // `esDirectivoD` pero no en `esDirectivoDEditor`.
      match /config/info {
        allow read:  if oid == orgId() && puedeVerObraD(obraId);
        allow write: if oid == orgId() && puedeEditarObraD(obraId);
      }
      match /config/parametros {
        allow read:  if oid == orgId() && puedeVerObraD(obraId);
        allow write: if oid == orgId() && puedeEditarObraD(obraId);
      }
      match /config/catalogo {
        allow read:  if oid == orgId() && puedeVerObraD(obraId);
        allow write: if oid == orgId() && puedeEditarObraD(obraId);
      }
      match /config/estimaciones {
        allow read:  if oid == orgId() && puedeVerObraD(obraId);
        allow write: if oid == orgId() && puedeEditarObraD(obraId);
      }
      match /config/permisos {
        allow read:  if oid == orgId() && puedeVerObraD(obraId);
        allow write: if oid == orgId() && esDirectivoDEditor();
      }

      // Donde escribe el supervisor cuando captura.
      match /avance/subs {
        allow read:  if oid == orgId() && puedeVerObraD(obraId);
        allow write: if oid == orgId() && puedeEditarObraD(obraId);
      }
      // Cortes semanales. De aquí sale el informe del artículo 73.
      // El contratista no los ve, igual que el `cliente` en constructora.
      match /avance/historial {
        allow read:  if oid == orgId() && puedeVerObraD(obraId) && !esContratista();
        allow write: if oid == orgId() && puedeEditarObraD(obraId);
      }
      // La nota de cada semana cerrada. Mismo permiso que el corte del que
      // habla, incluido el `!esContratista()`: la nota explica el cierre y se
      // lee junto a él, así que separarlos daría acceso por la puerta de atrás
      // a lo que la línea de arriba niega.
      match /avance/notas {
        allow read:  if oid == orgId() && puedeVerObraD(obraId) && !esContratista();
        allow write: if oid == orgId() && puedeEditarObraD(obraId);
      }
      // Incidencias. Append-only para quien captura; sólo dirección corrige.
      match /bitacora/{id} {
        allow read:   if oid == orgId() && puedeVerObraD(obraId) && !esContratista();
        allow create: if oid == orgId() && puedeEditarObraD(obraId);
        allow update, delete: if oid == orgId() && esDirectivoDEditor();
      }
    }

    // Marca del cliente. El paquete de marca de cotea lee de aquí, en tiempo
    // de ejecución, el logo que va junto al saludo. El manifest es del
    // producto —la app se llama cotea para todos—; esto es sólo del cliente.
    match /orgs/{oid}/config/branding {
      allow read:  if oid == orgId();
      allow write: if ((esAdminSistemaC() || esAdminSistemaD()) && oid == orgId())
                      || esSoporte();
    }

    // Comparativo cross-obras SOLO para director_obras/subdirector.
    // Explícitamente NO para contralor (según decisión 2026-09).
    match /orgs/{oid}/comparativo/{docId} {
      allow read: if oid == orgId() && esDependencia() && rol() in ['director_obras','subdirector'];
      allow write: if oid == orgId() && rol() == 'director_obras';
    }

    // Padrón general de contratistas (no ligado a obra específica)
    match /orgs/{oid}/contratistas/{cid} {
      allow read: if oid == orgId() && esDependencia() && rol() in ['director_obras','subdirector','jefe_supervision','contralor','administrativo'];
      // Contratista solo ve su propio doc
      allow read: if oid == orgId() && esContratista() && cid == request.auth.uid;
      allow write: if oid == orgId() && rol() in ['director_obras','subdirector','administrativo'];
    }

    // ─────────────────────────────────────────────────────────────────────
    // Colecciones globales de constructora (path legacy, sin org prefix)
    // Exigen tipo=='constructora'. Soporte NO lee (no ve montos).
    // Cliente NO lee (info interna).
    // ─────────────────────────────────────────────────────────────────────
    match /global/gp_construct {
      allow read: if esConstructora() && !esCliente();
      allow write: if false;
    }
    match /global/gp_detalle/obras/{obraGPId} {
      allow read: if esConstructora() && !esCliente();
      allow write: if false;
    }
    match /global/historial_obras {
      allow read: if esDirectivoC();
      allow write: if esDirectivoC();
    }
    // Registro de salud de las funciones programadas (#26). La escriben las
    // Cloud Functions con el admin SDK, que se salta estas reglas; aquí solo
    // hace falta abrir la LECTURA. Sin esto la pantalla de salud no sirve de
    // nada: su razón de ser es que el navegador pueda ver el estado del
    // backend cuando el backend está caído y no hay quien mande el correo.
    // Escritura cerrada a propósito: nadie desde el navegador debe poder
    // poner en verde una función que falló.
    match /global/health {
      allow read: if esDirectivoC() || esAdminSistemaC();
      allow write: if false;
    }

    // ─────────────────────────────────────────────────────────────────────
    // notificaciones/{uid}/items/{notifId} — solo el propio usuario
    // ─────────────────────────────────────────────────────────────────────
    match /notificaciones/{uid}/items/{notifId} {
      allow read: if esAuth() && request.auth.uid == uid;
      allow update: if esAuth() && request.auth.uid == uid;
      allow delete: if esAuth() && request.auth.uid == uid;
      allow create: if esAuth();
    }

    // ─────────────────────────────────────────────────────────────────────
    // auditoria/{id} — log append-only.
    // Lectura: directivos de constructora, directivos de dependencia.
    // (Soporte NO puede leer: sus propios registros los verá el auditor de
    //  la org que corresponda.)
    // ─────────────────────────────────────────────────────────────────────
    match /auditoria/{id} {
      allow read: if esDirectivoC() || esDirectivoD();
      allow create: if esAuth();  // incluye soporte — cada acción se registra
      allow update, delete: if false;
    }

    // ─────────────────────────────────────────────────────────────────────
    // health/* — panel de salud (solo admin_sistema constructora)
    // ─────────────────────────────────────────────────────────────────────
    match /health/{path=**} {
      allow read: if esConstructora() && rol() == 'admin_sistema';
      allow write: if false;
    }

    // ─────────────────────────────────────────────────────────────────────
    // DENY por defecto — cualquier otra ruta no declarada.
    // ─────────────────────────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
